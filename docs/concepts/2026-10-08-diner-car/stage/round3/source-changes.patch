+/** A softly lit interior, darkest beneath the lintel and beside the frame. */
+function windowLight(k: StageKit, width: number, height: number, at: V3) {
+  const geo = new THREE.PlaneGeometry(
+    width,
+    height,
+    6,
+    k.quality === 'high' ? 8 : 4,
+  );
+  k.add('glow', '#d4a46a', geo, at);
+  const pane = k.parts.glow![k.parts.glow!.length - 1],
+    pos = pane.getAttribute('position'),
+    colour = pane.getAttribute('color'),
+    amber = new THREE.Color('#d4a46a'),
+    shade = new THREE.Color('#614731'),
+    tint = new THREE.Color();
+  for (let i = 0; i < pos.count; i++) {
+    const u = (pos.getX(i) - at[0]) / width,
+      v = THREE.MathUtils.clamp((pos.getY(i) - at[1]) / height + 0.5, 0, 1),
+      lit = (0.24 + 0.76 * (1 - v) ** 0.65) * (1 - Math.abs(u) * 0.48);
+    tint.copy(shade).lerp(amber, lit);
+    colour.setXYZ(i, tint.r, tint.g, tint.b);
+  }
+}
+
+function cinemaGradient(quality: StageQuality) {
+  const width = quality === 'high' ? 256 : 128,
+    height = width / 2,
+    bytes = new Uint8Array(width * height * 4);
+  for (let y = 0; y < height; y++)
+    for (let x = 0; x < width; x++) {
+      const u = x / (width - 1),
+        v = y / (height - 1),
+        falloff =
+          0.7 + Math.sin(u * Math.PI) * 0.15 + Math.sin(v * Math.PI) * 0.15;
+      bytes.set(
+        [
+          Math.round((132 - v * 34) * falloff),
+          Math.round((188 - v * 35) * falloff),
+          Math.round((219 - v * 25) * falloff),
+          255,
+        ],
+        (y * width + x) * 4,
+      );
+    }
+  const tex = new THREE.DataTexture(bytes, width, height, THREE.RGBAFormat);
+  tex.colorSpace = THREE.SRGBColorSpace;
+  tex.minFilter = THREE.LinearMipmapLinearFilter;
+  tex.magFilter = THREE.LinearFilter;
+  tex.generateMipmaps = true;
+  tex.needsUpdate = true;
+  return tex;
+}
+
+/** Optical haze dissipates near the lamp; the broad end has no hard cutoff. */
+function lighthouseFade() {
+  const n = 64,
+    bytes = new Uint8Array(n * n * 4);
+  for (let y = 0; y < n; y++)
+    for (let x = 0; x < n; x++) {
+      const fade = Math.round(255 * (y / (n - 1)) ** 3.6);
+      bytes.set([fade, fade, fade, 255], (y * n + x) * 4);
+    }
+  const tex = new THREE.DataTexture(bytes, n, n, THREE.RGBAFormat);
+  tex.minFilter = tex.magFilter = THREE.LinearFilter;
+  tex.needsUpdate = true;
+  return tex;
+}
+
+/** Recessed lunar bowls and raised ejecta rims retain the approved disc outline. */
+function crateredMoon(quality: StageQuality, owned: { dispose(): void }[]) {
+  const geo = new THREE.SphereGeometry(
+    2.05,
+    quality === 'high' ? 96 : 48,
+    quality === 'high' ? 64 : 32,
+  );
+  geo.scale(1, 1, 0.085);
+  const pos = geo.getAttribute('position'),
+    colours = new Float32Array(pos.count * 3),
+    craters = [
+      [-0.85, 0.45, 0.4, 0.075],
+      [0.52, -0.52, 0.31, 0.07],
+      [0.46, 1.02, 0.36, 0.07],
+      [-0.33, -1.16, 0.26, 0.06],
+      [1.16, 0.48, 0.27, 0.055],
+      [-1.32, -0.48, 0.17, 0.04],
+      [0.05, 0.05, 0.16, 0.04],
+      [0.76, -1.17, 0.14, 0.033],
+      [-0.3, 1.44, 0.15, 0.038],
+    ];
+  for (let i = 0; i < pos.count; i++) {
+    const x = pos.getX(i),
+      y = pos.getY(i),
+      z = pos.getZ(i);
+    let relief = 0;
+    const mare =
+      Math.exp(-(((x + 0.65) / 0.75) ** 2 + ((y - 0.15) / 1.1) ** 2)) +
+      0.65 * Math.exp(-(((x - 0.85) / 0.55) ** 2 + ((y - 0.8) / 0.7) ** 2));
+    let value =
+      0.88 -
+      mare * 0.34 +
+      Math.sin(x * 21 + y * 13) * Math.sin(y * 27 - x * 9) * 0.025;
+    if (z > 0) {
+      for (const [cx, cy, radius, depth] of craters) {
+        const d = Math.hypot(x - cx, y - cy) / radius,
+          bowl = Math.max(0, 1 - d * d) ** 2,
+          rim = Math.exp(-(((d - 1) / 0.16) ** 2));
+        relief += rim * 0.035 - bowl * depth * 1.4;
+        const innerLight = ((x - cx) * -0.65 + (y - cy) * 0.35) / radius;
+        value += rim * 0.12 - bowl * 0.33 + bowl * innerLight * 0.2;
+      }
+      const edge = Math.min(1, z / 0.055);
+      pos.setZ(i, z + relief * edge);
+    }
+    colours.set([value * 0.96, value * 0.95, value], i * 3);
+  }
+  geo.setAttribute('color', new THREE.BufferAttribute(colours, 3));
+  geo.computeVertexNormals();
+  // A quiet raking-light tint keeps crater walls legible in both game cameras,
+  // even where the global moon light meets this shallow face edge-on.
+  const normals = geo.getAttribute('normal');
+  for (let i = 0; i < pos.count; i++) {
+    const light = Math.max(
+        0,
+        normals.getX(i) * -0.55 +
+          normals.getY(i) * 0.65 +
+          normals.getZ(i) * 0.52,
+      ),
+      shade = 0.55 + Math.min(1, light) * 0.45;
+    for (let c = 0; c < 3; c++) colours[i * 3 + c] *= shade;
+  }
+  geo.computeBoundingSphere();
+  const mat = new THREE.MeshStandardMaterial({
+    color: '#9994ab',
+    emissive: '#6c657e',
+    emissiveIntensity: 0.18,
+    vertexColors: true,
+    roughness: 1,
+    metalness: 0,
+  });
+  mat.name = 'soft-celestial-lunar-relief';
+  owned.push(mat);
+  const moon = new THREE.Mesh(geo, mat);
+  moon.name = 'moon';
+  moon.userData.dynamic = true;
+  moon.position.set(8.3, 1.7, -4.5);
+  moon.rotation.x = (-44 * Math.PI) / 180;
+  return moon;
+}
