+/** Cream laminate with sparse mineral chips, authored once in metre-scale UVs. */
+function counterLaminate() {
+  const n = 256,
+    bytes = new Uint8Array(n * n * 4);
+  const seed = (i: number) => {
+    let v = Math.imul(i + 41, 1597334677);
+    v = Math.imul(v ^ (v >>> 16), 2246822519);
+    return ((v ^ (v >>> 13)) >>> 0) / 4294967296;
+  };
+  for (let y = 0; y < n; y++)
+    for (let x = 0; x < n; x++) {
+      const grain = Math.round(seed(y * n + x) * 4 - 2);
+      bytes.set([224 + grain, 207 + grain, 176 + grain, 255], (y * n + x) * 4);
+    }
+  for (let i = 0; i < 190; i++) {
+    const cx = Math.floor(seed(i * 5) * n),
+      cy = Math.floor(seed(i * 5 + 1) * n),
+      rx = 1 + seed(i * 5 + 2) * 2.3,
+      ry = 0.8 + seed(i * 5 + 3) * 1.8,
+      colour = i % 4 === 0 ? [166, 116, 98] : [166, 151, 125];
+    for (let y = Math.floor(cy - ry); y <= cy + ry; y++)
+      for (let x = Math.floor(cx - rx); x <= cx + rx; x++) {
